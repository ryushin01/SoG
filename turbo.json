{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["SENTRY_DSN"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "build-storybook": {
      "outputs": ["storybook-static/**"]
    },
    "test:storybook": {
      "outputs": []
    }
  }
}
