{
  "name": "@sog/backoffice",
  "version": "0.4.1",
  "scripts": {
    "dev": "ng serve --port 4200",
    "build": "ng build --define \"SENTRY_DSN='${SENTRY_DSN:-}'\"",
    "test": "ng test --watch=false",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint": "eslint . --max-warnings 0 && steiger ./src",
    "build-storybook": "ng run backoffice:build-storybook",
    "storybook": "ng run backoffice:storybook",
    "test:storybook": "vitest run --config vitest.storybook.config.mts"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@sog/domain": "workspace:*",
    "@sog/monitoring": "workspace:*",
    "@sog/wms-client": "workspace:*",
    "@sog/wms-server": "workspace:*",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.3",
    "@angular-devkit/architect": "^0.2202.0",
    "@angular-devkit/core": "^22.2.0",
    "@angular/animations": "^22.2.0",
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/angular-vite": "10.6.6",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^30.0.0",
    "playwright": "latest",
    "storybook": "10.6.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
