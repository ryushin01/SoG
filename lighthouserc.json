{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-site.mjs",
      "url": ["http://localhost:4300/login", "http://localhost:4300/count/start"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      },
      "startServerReadyPattern": "데모 모드"
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
